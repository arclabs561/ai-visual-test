# API Keys for ai-visual-test
# Copy this to .env and fill in your API key for at least one provider.

# Provider is auto-detected from whichever key is set.
# Priority: Groq > Gemini > OpenAI > Claude > OpenRouter (cheapest first).
# To override auto-detection, set VLM_PROVIDER explicitly.
# VLM_PROVIDER=gemini

# API Keys -- set at least one
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Optional: Model tier (fast, balanced, best)
# VLM_MODEL_TIER=balanced

# Optional: Explicit model override (provider-specific)
# VLM_MODEL=gemini-2.5-pro
