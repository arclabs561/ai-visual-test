# Post-commit hook - runs after successful commit
# Useful for notifications, cleanup, or informational messages

COMMIT_HASH=$(git rev-parse --short HEAD)
COMMIT_MSG=$(git log -1 --pretty=%B)

echo "[OK] Commit $COMMIT_HASH created successfully"

# Check if this commit includes documentation changes
# Use rg (ripgrep) if available, fallback to grep
RG_CMD=$(command -v rg || echo "grep")
if git diff HEAD~1 HEAD --name-only | $RG_CMD -qE "\.(md|MD)$" 2>/dev/null || git diff HEAD~1 HEAD --name-only | grep -qE "\.(md|MD)$" 2>/dev/null; then
  echo "[INFO] Documentation files were modified in this commit"
fi

# Check if this commit includes test changes
if git diff HEAD~1 HEAD --name-only | $RG_CMD -qE "(test|spec)" 2>/dev/null || git diff HEAD~1 HEAD --name-only | grep -qE "(test|spec)" 2>/dev/null; then
  echo "[INFO] Test files were modified in this commit"
fi

# Suggest next steps based on commit type
if echo "$COMMIT_MSG" | $RG_CMD -qE "^feat:" 2>/dev/null || echo "$COMMIT_MSG" | grep -qE "^feat:" 2>/dev/null; then
  echo "[INFO] Feature commit - consider:"
  echo "   - Updating CHANGELOG.md"
  echo "   - Adding/updating tests"
  echo "   - Updating documentation"
fi

if echo "$COMMIT_MSG" | $RG_CMD -qE "^fix:" 2>/dev/null || echo "$COMMIT_MSG" | grep -qE "^fix:" 2>/dev/null; then
  echo "[INFO] Fix commit - consider:"
  echo "   - Adding a test to prevent regression"
  echo "   - Updating CHANGELOG.md"
fi

# Show files changed in this commit
FILES_CHANGED=$(git diff HEAD~1 HEAD --name-only --diff-filter=ACM | wc -l | tr -d ' ')
if [ "$FILES_CHANGED" -gt 0 ]; then
  echo "[INFO] $FILES_CHANGED file(s) changed in this commit"
fi

