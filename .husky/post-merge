# Post-merge hook - runs after git merge or git pull
# Useful for installing dependencies, rebuilding, etc.

echo "[INFO] Post-merge actions..."

# Check if package.json or package-lock.json changed
# Use rg (ripgrep) if available, fallback to grep
RG_CMD=$(command -v rg || echo "grep")
if git diff HEAD@{1} HEAD --name-only | $RG_CMD -qE "(package\.json|package-lock\.json)" 2>/dev/null || git diff HEAD@{1} HEAD --name-only | grep -qE "(package\.json|package-lock\.json)" 2>/dev/null; then
  echo "[INFO] Dependencies may have changed, consider running:"
  echo "   npm install"
fi

# Check if husky hooks need updating
if git diff HEAD@{1} HEAD --name-only | $RG_CMD -qE "\.husky/" 2>/dev/null || git diff HEAD@{1} HEAD --name-only | grep -qE "\.husky/" 2>/dev/null; then
  echo "[INFO] Git hooks were updated, they're already active"
fi

# Show what was merged
MERGE_COMMITS=$(git log --merges --oneline HEAD@{1}..HEAD 2>/dev/null | wc -l | tr -d ' ')
if [ "$MERGE_COMMITS" -gt 0 ]; then
  echo "[INFO] Merged $MERGE_COMMITS merge commit(s)"
  echo "   Review changes: git log HEAD@{1}..HEAD"
fi

# Warn if there are uncommitted changes after merge
if ! git diff-index --quiet HEAD --; then
  echo "[WARN] Warning: You have uncommitted changes after merge"
  echo "   Review with: git status"
fi

