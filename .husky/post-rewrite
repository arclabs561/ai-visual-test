# Post-rewrite hook - runs after git rebase, git commit --amend, etc.
# Useful for cleanup and notifications after history rewriting

REWRITE_TYPE=$1

echo "[INFO] Post-rewrite: $REWRITE_TYPE"

if [ "$REWRITE_TYPE" = "rebase" ]; then
  echo "[INFO] Git history was rewritten (rebase)"
  echo "   If you've already pushed, you'll need to force push:"
  echo "   git push --force-with-lease"
  echo ""
  echo "[WARN] Warning: Force pushing rewrites history on remote"
  echo "   Only do this if you're sure no one else has pulled your changes"
fi

if [ "$REWRITE_TYPE" = "amend" ]; then
  echo "[INFO] Last commit was amended"
  echo "   If you've already pushed, you'll need to force push:"
  echo "   git push --force-with-lease"
fi

# Check if package.json changed during rewrite
# Use rg (ripgrep) if available, fallback to grep
RG_CMD=$(command -v rg || echo "grep")
if git diff HEAD@{1} HEAD --name-only 2>/dev/null | $RG_CMD -qE "(package\.json|package-lock\.json)" 2>/dev/null || git diff HEAD@{1} HEAD --name-only 2>/dev/null | grep -qE "(package\.json|package-lock\.json)" 2>/dev/null; then
  echo "[INFO] Dependencies may have changed, consider running: npm install"
fi

# Show what changed
COMMITS_REWRITTEN=$(git reflog show HEAD@{1}..HEAD 2>/dev/null | wc -l | tr -d ' ' || echo "?")
if [ -n "$COMMITS_REWRITTEN" ] && [ "$COMMITS_REWRITTEN" != "?" ]; then
  echo "[INFO] $COMMITS_REWRITTEN commit(s) affected"
fi

