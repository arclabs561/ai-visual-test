# Secrets Ignore Configuration
# 
# This file allows you to exclude specific patterns or files from secret detection.
# Copy this to .secretsignore and customize as needed.
#
# Format:
# - Lines starting with # are comments
# - pattern: <regex> - Exclude lines matching this regex
# - file: <path> - Exclude this file or path pattern
# - <path> - Simple file path or glob pattern

# Example: Exclude specific test files
# file: test/fixtures/secrets.test.mjs

# Example: Exclude patterns that are false positives
# pattern: my_custom_api_key_format

# Example: Exclude entire directories
# file: docs/examples/*


# Rate limiter error messages (false positives)
pattern: Rate limit exceeded.*requests per.*seconds
pattern: Cost limit exceeded.*per.*minutes

# Error messages mentioning API keys (not actual keys)
pattern: Check API key
pattern: API returned.*Status.*Check API key
pattern: OpenRouter API returned.*Check API key
pattern: .*returned non-JSON response.*Check API key
pattern: Verify API credentials
pattern: OpenRouter API returned.*Verify API credentials
pattern: .*returned non-JSON response.*Verify API credentials

# Cache key generation functions (not secrets)
pattern: generateTextLLMCacheKey|generateCacheKey
pattern: const key = generate.*CacheKey

# Template literals with variables (common patterns)
pattern: LRU eviction.*entries removed
pattern: Warm-start step.*research.*LLMs good early
