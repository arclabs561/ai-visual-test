{
  "name": "@arclabs561/ai-visual-test",
  "version": "0.14.0",
  "description": "Visual testing with vision language models",
  "type": "module",
  "main": "build/src/index.js",
  "types": "./build/src/index.d.ts",
  "bin": {
    "ai-visual-test": "./build/bin/ai-visual-test.js"
  },
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    },
    "./validators": {
      "types": "./build/src/validators/index.d.ts",
      "import": "./build/src/validators/index.js"
    },
    "./temporal": {
      "types": "./build/src/temporal/index.d.ts",
      "import": "./build/src/temporal/index.js"
    },
    "./multi-modal": {
      "types": "./build/src/multi-modal/index.d.ts",
      "import": "./build/src/multi-modal/index.js"
    },
    "./ensemble": {
      "types": "./build/src/ensemble/index.d.ts",
      "import": "./build/src/ensemble/index.js"
    },
    "./video": {
      "types": "./build/src/video.d.ts",
      "import": "./build/src/video.js"
    },
    "./extractors": {
      "types": "./build/src/extractors.d.ts",
      "import": "./build/src/extractors.js"
    },
    "./persona": {
      "types": "./build/src/persona/index.d.ts",
      "import": "./build/src/persona/index.js"
    },
    "./utils": {
      "types": "./build/src/utils/index.d.ts",
      "import": "./build/src/utils/index.js"
    },
    "./game": {
      "types": "./build/src/game/index.d.ts",
      "import": "./build/src/game/index.js"
    },
    "./errors": {
      "types": "./build/src/errors/index.d.ts",
      "import": "./build/src/errors/index.js"
    },
    "./playwright": {
      "types": "./build/src/integrations/playwright.d.ts",
      "import": "./build/src/integrations/playwright.js"
    },
    "./vitest": {
      "types": "./build/src/integrations/vitest-jest.d.ts",
      "import": "./build/src/integrations/vitest-jest.js"
    },
    "./jest": {
      "types": "./build/src/integrations/vitest-jest.d.ts",
      "import": "./build/src/integrations/vitest-jest.js"
    },
    "./perception": {
      "types": "./build/src/perception/index.d.ts",
      "import": "./build/src/perception/index.js"
    },
    "./improvement": {
      "types": "./build/src/improvement/index.d.ts",
      "import": "./build/src/improvement/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#provider-adapters": "./build/src/provider-adapters.js",
    "#dataset-evaluation-metrics": "./build/src/dataset-evaluation-metrics.js",
    "#ensemble-judge": "./build/src/ensemble-judge.js",
    "#errors": "./build/src/errors.js",
    "#game-action-contract": "./build/src/game-action-contract.js",
    "#game-convenience": "./build/src/game-convenience.js",
    "#game-goal-prompts": "./build/src/game-goal-prompts.js",
    "#game-player": "./build/src/game-player.js",
    "#judge": "./build/src/judge.js",
    "#pairwise-fixture-metrics": "./build/src/pairwise-fixture-metrics.js",
    "#page-validation": "./build/src/page-validation.js",
    "#playwright-integration": "./build/src/integrations/playwright.js",
    "#position-counterbalance": "./build/src/position-counterbalance.js",
    "#public-contract": "./build/src/public-contract.js",
    "#review-contract": "./build/src/review-contract.js",
    "#research-enhanced-validation": "./build/src/research-enhanced-validation.js",
    "#structured-output": "./build/src/structured-output.js",
    "#structured-task": "./build/src/structured-task.js",
    "#temporal-capture": "./build/src/temporal-capture.js",
    "#temporal-core": "./build/src/temporal-core.js",
    "#temporal-multi-scale": "./build/src/temporal-multi-scale.js",
    "#temporal-orchestration": "./build/src/temporal-orchestration.js",
    "#temporal-prompt-formatting": "./build/src/temporal-prompt-formatting.js",
    "#validation-result-normalizer": "./build/src/validation-result-normalizer.js",
    "#video": "./build/src/video.js"
  },
  "files": [
    "build/bin/",
    "build/src/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run build:stage && node scripts/run-staged-tests.mjs unit",
    "test:integration": "npm run build:stage && node scripts/run-staged-tests.mjs integration",
    "test:e2e": "npm run build:stage && node scripts/run-staged-tests.mjs e2e",
    "test:security": "npm run build:stage && node scripts/run-staged-tests.mjs security",
    "pretest:playwright-integration": "npm run build:stage",
    "test:playwright-integration": "playwright test --config test/integration/playwright.config.mjs",
    "test:types": "npm run build:stage && tsc -p tsconfig.declarations.json",
    "test:package": "npm run build:skip-obfuscation && node scripts/verify-packed-package.mjs",
    "evaluate:pairwise-fixtures": "npm run build:stage && node scripts/evaluate-pairwise-fixtures.mjs",
    "evaluate:dataset": "npm run build:stage && node scripts/evaluate-dataset-results.mjs",
    "evaluate:diffspot": "npm run build:stage && node scripts/evaluate-diffspot.mjs",
    "evaluate:uicrit": "npm run build:stage && node scripts/evaluate-uicrit.mjs",
    "evaluate:gui-aesthetics": "npm run build:stage && node scripts/evaluate-gui-aesthetics.mjs",
    "evaluate:grounding": "npm run build:stage && node scripts/evaluate-public-grounding.mjs",
    "evaluate:betterapp": "npm run build:stage && node scripts/evaluate-betterapp.mjs",
    "evaluate:apple-rldf": "npm run build:stage && node scripts/evaluate-apple-rldf.mjs",
    "normalize:apple-rldf": "uv run scripts/normalize-apple-rldf.py",
    "build:stage": "node scripts/build-stage.mjs",
    "prepare": "npm run build:stage",
    "build": "npm run build:stage && node scripts/build-obfuscated.mjs",
    "build:skip-obfuscation": "npm run build:stage && node scripts/build-obfuscated.mjs --skip-obfuscation",
    "prepublishOnly": "npm run test:unit && npm run test:types && npm run build && node scripts/verify-packed-package.mjs",
    "check:secrets": "node scripts/detect-secrets.mjs",
    "install:playwright": "npx playwright install chromium",
    "playwright:check": "node scripts/ensure-playwright.mjs",
    "playwright:install": "node scripts/ensure-playwright.mjs --install",
    "playwright:setup": "node scripts/ensure-playwright.mjs --install --install-browsers"
  },
  "keywords": [
    "visual-testing",
    "ai",
    "vllm",
    "vision-language-models",
    "playwright",
    "accessibility",
    "ui-testing",
    "screenshot-validation"
  ],
  "author": "arclabs561 <henry@henrywallace.io>",
  "license": "MIT",
  "dependencies": {
    "async-mutex": "0.5.0",
    "typebox": "1.3.20"
  },
  "peerDependencies": {
    "@arclabs561/llm-utils": "^0.1.0",
    "@playwright/test": "^1.48.0"
  },
  "peerDependenciesMeta": {
    "@arclabs561/llm-utils": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.0.0",
    "fast-check": "4.8.0",
    "javascript-obfuscator": "5.4.3",
    "playwright": "1.60.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arclabs561/ai-visual-test.git"
  },
  "homepage": "https://github.com/arclabs561/ai-visual-test#readme",
  "bugs": {
    "url": "https://github.com/arclabs561/ai-visual-test/issues"
  }
}
