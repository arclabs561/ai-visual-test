{
  "name": "@arclabs561/ai-visual-test",
  "version": "0.7.1",
  "description": "Visual testing framework for web applications using Vision Language Models",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./validators": "./src/validators/index.mjs",
    "./temporal": "./src/temporal/index.mjs",
    "./multi-modal": "./src/multi-modal/index.mjs",
    "./ensemble": "./src/ensemble/index.mjs",
    "./persona": "./src/persona/index.mjs",
    "./specs": "./src/specs/index.mjs",
    "./utils": "./src/utils/index.mjs",
    "./playwright": "./src/integrations/playwright.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.mjs",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DEPLOYMENT.md",
    "SECURITY.md",
    "LICENSE",
    ".secretsignore.example",
    "API_QUICK_REFERENCE.md",
    "EXAMPLES.md"
  ],
  "scripts": {
    "_comment_testing": "=== Testing Scripts ===",
    "test": "node --test test/**/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test:security": "node --test test/security/*.test.mjs",
    "test:performance": "node --test test/performance/*.test.mjs",
    "test:datasets": "node --test test/datasets/*.test.mjs",
    "test:validation": "node --test test/**/validation-*.test.mjs",
    "test:playwright": "playwright test test/**/playwright-*.test.mjs",
    "test:playwright:ui": "playwright test test/**/playwright-*.test.mjs --ui",
    "test:playwright-integration": "playwright test test/integration/playwright-integration.pwtest.mjs",
    "test:evaluation": "node test/evaluation-adapter-integration.test.mjs",
    "test:intelligence": "node scripts/verify-intelligence.mjs",
    "test:all": "npm run test:evaluation && npm run test:playwright",
    "test:slow": "npm test 2>&1 | rg '✔.*\\([0-9]+\\.[0-9]+ms\\)' | sort -t'(' -k2 -nr | head -20",
    "test:organize": "node scripts/organize-tests.mjs --dry-run",
    "test:organize:apply": "node scripts/organize-tests.mjs",
    "_comment_evaluation": "=== Evaluation Scripts ===",
    "evaluate": "node evaluation/runners/evaluate-cli.mjs",
    "evaluate:quick": "node evaluation/runners/evaluate-cli.mjs --dataset real --limit 4",
    "evaluate:real": "node evaluation/runners/evaluate-cli.mjs real",
    "evaluate:webui": "node evaluation/runners/evaluate-cli.mjs webui",
    "evaluate:wcag": "node evaluation/runners/evaluate-cli.mjs wcag",
    "compare-metrics": "node evaluation/utils/compare-filtered-metrics.mjs",
    "_comment_playwright": "=== Playwright Setup ===",
    "install:playwright": "npx playwright install chromium",
    "playwright:check": "node scripts/ensure-playwright.mjs",
    "playwright:install": "node scripts/ensure-playwright.mjs --install",
    "playwright:setup": "node scripts/ensure-playwright.mjs --install --install-browsers",
    "_comment_annotation": "=== Annotation & Datasets ===",
    "annotate": "node evaluation/utils/invoke-human-annotation.mjs",
    "annotate:quick": "node evaluation/utils/quick-start-annotation.mjs",
    "annotate:full": "node evaluation/utils/start-human-annotation.mjs",
    "validate:annotations": "node evaluation/utils/validate-annotation-quality.mjs",
    "validate:dataset": "node evaluation/utils/validate-dataset-quality.mjs",
    "match:vllm": "node evaluation/utils/match-annotations-with-vllm.mjs",
    "datasets:download": "node evaluation/utils/download-all-datasets.mjs",
    "datasets:parse": "node evaluation/utils/parse-all-datasets.mjs",
    "datasets:setup": "npm run datasets:download && npm run datasets:parse",
    "_comment_build": "=== Build & Documentation ===",
    "build": "node scripts/build-obfuscated.mjs",
    "build:skip-obfuscation": "node scripts/build-obfuscated.mjs --skip-obfuscation",
    "docs": "node scripts/generate-docs.mjs",
    "docs:consolidate": "node scripts/consolidate-docs.mjs --dry-run",
    "docs:consolidate:apply": "node scripts/consolidate-docs.mjs",
    "lint": "echo 'No linter configured'",
    "prepublishOnly": "npm test && npm run build",
    "_comment_quality": "=== Quality Checks ===",
    "check": "npx hookwise check 2>&1 || (EXIT_CODE=$?; if [ $EXIT_CODE -eq 127 ]; then echo '⚠️  Hookwise not available (optional developer tooling). Install with: npm link ../../dev/hookwise'; else exit $EXIT_CODE; fi)",
    "check:all": "npm run check:secrets && (npx hookwise check 2>/dev/null || echo '⚠️  Hookwise not available (optional developer tooling)') && npm run check:test-performance",
    "check:secrets": "node scripts/detect-secrets.mjs",
    "check:security": "npm run check:secrets",
    "check:quality": "npx hookwise test-quality 2>/dev/null || echo '⚠️  Hookwise not available (optional developer tooling)'",
    "check:docs": "npx hookwise test-docs 2>/dev/null || echo '⚠️  Hookwise not available (optional developer tooling)'",
    "check:test-performance": "node node_modules/@arclabs561/hookwise/src/hooks/test-performance.mjs 2>/dev/null || node scripts/analyze-test-performance.mjs",
    "check:commit": "test -f .git/COMMIT_EDITMSG && npx hookwise test-commit \"$(cat .git/COMMIT_EDITMSG)\" 2>/dev/null || echo '⚠️  Hookwise not available or no commit message (optional developer tooling)'",
    "_comment_garden": "=== Garden (Code Quality) ===",
    "garden": "npm run check",
    "garden:enhanced": "node scripts/enhanced-garden.mjs",
    "garden:watch": "node scripts/watch-garden.mjs",
    "deprecate:old": "node scripts/deprecate-old-package.mjs"
  },
  "keywords": [
    "visual-testing",
    "ai",
    "vllm",
    "vision-language-models",
    "playwright",
    "accessibility",
    "ui-testing",
    "screenshot-validation"
  ],
  "author": "arclabs561 <henry@henrywallace.io>",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.70.0",
    "@google/generative-ai": "0.24.1",
    "async-mutex": "0.5.0",
    "dotenv": "^16.4.5",
    "openai": "6.9.1"
  },
  "peerDependencies": {
    "@arclabs561/llm-utils": "*",
    "@playwright/test": "^1.48.0"
  },
  "peerDependenciesMeta": {
    "@arclabs561/llm-utils": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.1",
    "@xenova/transformers": "2.17.2",
    "fast-check": "4.3.0",
    "javascript-obfuscator": "4.1.1",
    "playwright": "1.56.1",
    "proper-lockfile": "4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arclabs561/ai-visual-test.git"
  },
  "homepage": "https://github.com/arclabs561/ai-visual-test#readme",
  "bugs": {
    "url": "https://github.com/arclabs561/ai-visual-test/issues"
  }
}
