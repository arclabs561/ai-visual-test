{
  "name": "@arclabs561/ai-visual-test",
  "version": "0.12.0",
  "description": "Visual testing with vision language models",
  "type": "module",
  "main": "src/index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "ai-visual-test": "./bin/ai-visual-test.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs"
    },
    "./validators": {
      "types": "./types/validators.d.ts",
      "import": "./src/validators/index.mjs"
    },
    "./temporal": {
      "types": "./types/temporal.d.ts",
      "import": "./src/temporal/index.mjs"
    },
    "./multi-modal": {
      "types": "./types/multi-modal.d.ts",
      "import": "./src/multi-modal/index.mjs"
    },
    "./ensemble": {
      "types": "./types/ensemble.d.ts",
      "import": "./src/ensemble/index.mjs"
    },
    "./video": {
      "types": "./types/video.d.ts",
      "import": "./src/video.mjs"
    },
    "./extractors": {
      "types": "./types/extractors.d.ts",
      "import": "./src/extractors.mjs"
    },
    "./persona": {
      "types": "./types/persona.d.ts",
      "import": "./src/persona/index.mjs"
    },
    "./utils": {
      "types": "./types/utils.d.ts",
      "import": "./src/utils/index.mjs"
    },
    "./game": {
      "types": "./types/game.d.ts",
      "import": "./src/game/index.mjs"
    },
    "./errors": {
      "types": "./types/errors.d.ts",
      "import": "./src/errors/index.mjs"
    },
    "./playwright": {
      "types": "./types/playwright.d.ts",
      "import": "./src/integrations/playwright.mjs"
    },
    "./vitest": {
      "types": "./types/vitest-jest.d.ts",
      "import": "./src/integrations/vitest-jest.mjs"
    },
    "./jest": {
      "types": "./types/vitest-jest.d.ts",
      "import": "./src/integrations/vitest-jest.mjs"
    },
    "./perception": {
      "types": "./types/perception.d.ts",
      "import": "./src/perception/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#review-contract": "./build/src/review-contract.js"
  },
  "files": [
    "bin/",
    "src/**/*.mjs",
    "index.d.ts",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run build:stage && node scripts/run-staged-tests.mjs unit",
    "test:integration": "npm run build:stage && node scripts/run-staged-tests.mjs integration",
    "test:e2e": "npm run build:stage && node scripts/run-staged-tests.mjs e2e",
    "test:security": "npm run build:stage && node scripts/run-staged-tests.mjs security",
    "test:performance": "npm run build:stage && node scripts/run-staged-tests.mjs performance",
    "test:datasets": "npm run build:stage && node scripts/run-staged-tests.mjs datasets",
    "test:validation": "npm run build:stage && node scripts/run-staged-tests.mjs validation",
    "test:playwright": "playwright test test/**/playwright-*.test.mjs",
    "test:playwright-integration": "playwright test test/integration/playwright-integration.pwtest.mjs",
    "test:types": "tsc -p tsconfig.declarations.json",
    "test:package": "npm run build:skip-obfuscation && node scripts/verify-packed-package.mjs",
    "test:intelligence": "node scripts/verify-intelligence.mjs",
    "build:stage": "node scripts/build-stage.mjs",
    "prepare": "npm run build:stage",
    "build": "npm run build:stage && node scripts/build-obfuscated.mjs",
    "build:skip-obfuscation": "npm run build:stage && node scripts/build-obfuscated.mjs --skip-obfuscation",
    "prepublishOnly": "npm run test:unit && npm run test:types && npm run build && node scripts/verify-packed-package.mjs",
    "check:secrets": "node scripts/detect-secrets.mjs",
    "install:playwright": "npx playwright install chromium",
    "playwright:check": "node scripts/ensure-playwright.mjs",
    "playwright:install": "node scripts/ensure-playwright.mjs --install",
    "playwright:setup": "node scripts/ensure-playwright.mjs --install --install-browsers"
  },
  "keywords": [
    "visual-testing",
    "ai",
    "vllm",
    "vision-language-models",
    "playwright",
    "accessibility",
    "ui-testing",
    "screenshot-validation"
  ],
  "author": "arclabs561 <henry@henrywallace.io>",
  "license": "MIT",
  "dependencies": {
    "async-mutex": "0.5.0",
    "typebox": "1.3.20"
  },
  "peerDependencies": {
    "@arclabs561/llm-utils": "*",
    "@playwright/test": "^1.48.0"
  },
  "peerDependenciesMeta": {
    "@arclabs561/llm-utils": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.0.0",
    "fast-check": "4.8.0",
    "javascript-obfuscator": "5.4.3",
    "playwright": "1.60.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arclabs561/ai-visual-test.git"
  },
  "homepage": "https://github.com/arclabs561/ai-visual-test#readme",
  "bugs": {
    "url": "https://github.com/arclabs561/ai-visual-test/issues"
  }
}
