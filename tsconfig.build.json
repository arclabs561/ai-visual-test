{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "types": ["node"],
    "paths": {
      "@arclabs561/ai-visual-test/ensemble": ["./types/ensemble-barrel.d.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.mjs",
    "src/**/*.ts",
    "bin/**/*.mjs",
    "bin/**/*.ts",
    "test/**/*.mjs",
    "test/**/*.ts"
  ],
  "exclude": ["build", "dist", "node_modules", "test/types"]
}
