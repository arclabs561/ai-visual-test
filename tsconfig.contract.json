{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "build/src",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/public-contract.ts",
    "src/index.ts",
    "src/extractors.ts",
    "src/errors.ts",
    "src/errors/index.ts",
    "src/validators/accessibility-programmatic.ts",
    "src/validators/accessibility-validator.ts",
    "src/validators/batch-validator.ts",
    "src/validators/hybrid-validator.ts",
    "src/validators/index.ts",
    "src/validators/prompt-builder.ts",
    "src/validators/rubric.ts",
    "src/validators/state-programmatic.ts",
    "src/validators/state-validator.ts",
    "src/review-contract.ts",
    "src/provider-adapters.ts",
    "src/structured-output.ts",
    "src/structured-task.ts",
    "src/validation-result-normalizer.ts",
    "src/video.ts",
    "src/position-counterbalance.ts",
    "src/ensemble-judge.ts",
    "src/bias-detector.ts",
    "src/bias-mitigation.ts",
    "src/research-enhanced-validation.ts",
    "src/ensemble/index.ts",
    "src/game-action-contract.ts",
    "src/game-convenience.ts",
    "src/game-goal-prompts.ts",
    "src/game-player.ts",
    "src/judge.ts",
    "src/game/index.ts",
    "src/temporal-capture.ts",
    "src/temporal-core.ts",
    "src/temporal-multi-scale.ts",
    "src/temporal-orchestration.ts",
    "src/temporal-prompt-formatting.ts",
    "src/temporal/index.ts",
    "src/page-validation.ts",
    "src/perception/contracts.ts",
    "src/perception/prompts.ts",
    "src/perception/aggregate.ts",
    "src/perception/learn.ts",
    "src/perception/report.ts",
    "src/perception/sample.ts",
    "src/perception/openrouter.ts",
    "src/perception/critiques.ts",
    "src/perception/index.ts",
    "src/integrations/playwright.ts",
    "src/integrations/vitest-jest.ts"
  ]
}
