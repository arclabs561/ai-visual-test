{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "build/src",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/public-contract.ts",
    "src/review-contract.ts",
    "src/provider-adapters.ts",
    "src/structured-output.ts",
    "src/validation-result-normalizer.ts",
    "src/position-counterbalance.ts",
    "src/page-validation.ts",
    "src/integrations/vitest-jest.ts"
  ]
}
